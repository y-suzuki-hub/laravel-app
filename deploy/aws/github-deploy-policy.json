{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "UploadAndShareReleases",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::BUCKET_NAME/releases/*"
        },
        {
            "Sid": "RunDeployCommand",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": [
                "arn:aws:ec2:ap-northeast-1:ACCOUNT_ID:instance/INSTANCE_ID",
                "arn:aws:ssm:ap-northeast-1::document/AWS-RunShellScript"
            ]
        },
        {
            "Sid": "ReadDeployResult",
            "Effect": "Allow",
            "Action": "ssm:GetCommandInvocation",
            "Resource": "*"
        }
    ]
}
